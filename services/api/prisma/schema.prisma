// ============================================================================
// Prisma schema — HỌ NHÀ TÔI
// Căn cứ: Technical-Spec.md mục 2 (sơ đồ CSDL), các quy tắc HNT-T-010,
//         HNT-T-023 (không CASCADE từ users sang dữ liệu gia phả/chat của
//         người khác — dùng SET NULL + snapshot), HNT-T-024 (verification_status
//         tách khỏi genealogy_permissions).
// Quy ước: tên bảng/cột trong DB dùng snake_case (@@map/@map); khóa chính UUID.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

/// Trạng thái tài khoản (spec 2.2, bảng users).
enum UserStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  DELETED   @map("deleted")
}

/// Trạng thái xác minh hồ sơ gia phả — TRỤC ĐỘC LẬP với quyền truy cập
/// (HNT-T-024: đổi verification_status không làm đổi kết quả kiểm tra
/// genealogy_permissions và ngược lại).
enum VerificationStatus {
  DRAFT               @map("draft")
  PENDING_VERIFICATION @map("pending_verification")
  VERIFIED            @map("verified")
  DISPUTED            @map("disputed")
}

/// 3 vai trò trong phạm vi dòng họ (gộp từ 7 vai trò cũ, 28/10/2026).
/// - MEMBER: thành viên — xem, đề xuất sửa gia phả.
/// - EDITOR: người giữ gia phả — sửa trực tiếp, duyệt đề xuất (trước đây
///   là genealogy_manager).
/// - ADMIN: ban quản trị — duyệt người vào họ, mã mời, cấp/thu vai trò EDITOR.
/// "Trưởng tộc" = ADMIN đồng thời là lineages.owner_user_id (duy nhất mỗi họ):
/// riêng người này cấp/thu ADMIN, chuyển quyền sở hữu, xóa họ.
/// Quyền nền tảng tách riêng ở users.is_platform_admin (không gắn dòng họ).
/// Chuyển dữ liệu từ enum cũ: prisma/sql/2026-10-28-gop-vai-tro.sql.
enum LineageRole {
  MEMBER @map("member")
  EDITOR @map("editor")
  ADMIN  @map("admin")
}

/// Loại cuộc trò chuyện (spec 2.4, bảng chat_conversations).
enum ChatRoomType {
  DIRECT        @map("direct")
  LINEAGE_GROUP @map("lineage_group")
  FAMILY_GROUP  @map("family_group")
}

/// Loại sự kiện (spec 2.6, bảng events).
enum EventType {
  ANCESTRAL_CEREMONY @map("ancestral_ceremony")
  DEATH_ANNIVERSARY  @map("death_anniversary")
  BIRTHDAY           @map("birthday")
  FAMILY_MEETING     @map("family_meeting")
  GATHERING          @map("gathering")
  OTHER              @map("other")
}

// ---------------------------------------------------------------------------
// 2.2. NHÓM DANH TÍNH VÀ TÀI KHOẢN
// ---------------------------------------------------------------------------

/// Tài khoản đăng nhập. KHÔNG đồng nhất với family_persons (HNT-T-011).
/// Mọi FK từ dữ liệu gia phả/tin nhắn/bài viết trỏ về users đều ON DELETE
/// SET NULL (giữ snapshot) — tuyệt đối không CASCADE sang dữ liệu người khác.
model User {
  id           String     @id @default(uuid()) @db.Uuid
  phone        String?    @unique @db.VarChar(20)
  email        String?    @unique @db.VarChar(255)
  passwordHash String?    @map("password_hash") @db.Text
  displayName  String     @map("display_name") @db.VarChar(100)
  avatarUrl    String?    @map("avatar_url") @db.Text
  status       UserStatus @default(ACTIVE)
  /// Quản trị nền tảng (người vận hành). Chỉ bật bằng SQL — không có API
  /// nào cấp quyền này.
  isPlatformAdmin Boolean @default(false) @map("is_platform_admin")
  /// Email đã được xác minh (hiện chỉ qua Google). Email tự khai khi đăng
  /// ký bằng mật khẩu để null.
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  /// Định danh tài khoản Google (claim `sub`), dùng cho đăng nhập Google.
  googleSub       String?   @unique @map("google_sub") @db.VarChar(64)
  /// Chống dò mật khẩu: sai 5 lần liên tiếp thì khóa 15 phút.
  failedLoginCount Int      @default(0) @map("failed_login_count")
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)

  profile                MemberProfile?
  sessions               UserSession[]
  pushDevices            PushDevice[]
  createdLineages        Lineage[]               @relation("LineageCreator")
  ownedLineages          Lineage[]               @relation("LineageOwner")
  lineageMemberships     LineageMembership[]
  reviewedMemberships    LineageMembership[]     @relation("MembershipReviewer")
  createdInvites         LineageInvite[]
  createdPersons         FamilyPerson[]          @relation("PersonCreator")
  updatedPersons         FamilyPerson[]          @relation("PersonUpdater")
  createdRelationships   FamilyRelationship[]
  personAccountLinks     PersonAccountLink[]
  verifiedAccountLinks   PersonAccountLink[]     @relation("AccountLinkVerifier")
  requestedChanges       GenealogyChangeRequest[] @relation("ChangeRequester")
  reviewedChanges        GenealogyChangeRequest[] @relation("ChangeReviewer")
  genealogyPermissions   GenealogyPermission[]
  grantedPermissions     GenealogyPermission[]   @relation("PermissionGranter")
  createdConversations   ChatConversation[]
  conversationMembers    ConversationMember[]
  sentMessages           Message[]
  messageReactions       MessageReaction[]
  messageReads           MessageRead[]
  sentMessageRequests    MessageRequest[]        @relation("MessageRequester")
  receivedMessageRequests MessageRequest[]      @relation("MessageTarget")
  sentFriendships        Friendship[]            @relation("FriendRequester")
  receivedFriendships    Friendship[]            @relation("FriendAddressee")
  blocking               BlockedUser[]           @relation("Blocker")
  blockedBy              BlockedUser[]           @relation("Blocked")
  filedReports           Report[]                @relation("Reporter")
  handledReports         Report[]                @relation("ReportHandler")
  posts                  Post[]
  comments               Comment[]
  postReactions          PostReaction[]
  organizedEvents        Event[]                 @relation("EventOrganizer")
  createdEvents          Event[]                 @relation("EventCreator")
  eventParticipations    EventParticipant[]
  createdPolls           Poll[]
  pollVotes              PollVote[]
  notifications          Notification[]
  notificationSetting    NotificationSetting?
  auditLogs              AuditLog[]
  deletionRequests       DataDeletionRequest[]

  // CHECK (phone IS NOT NULL OR email IS NOT NULL) — bổ sung trong migration SQL.
  @@map("users")
}

/// Hồ sơ cá nhân của chủ tài khoản (khác family_persons).
model MemberProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName        String   @map("full_name") @db.VarChar(150)
  nickname        String?  @db.VarChar(100)
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  gender          String?  @db.VarChar(20)
  hometown        String?  @db.VarChar(255)
  currentCity     String?  @map("current_city") @db.VarChar(255)
  occupation      String?  @db.VarChar(255)
  education       String?  @db.VarChar(255)
  bio             String?  @db.Text
  bloodType       String?  @map("blood_type") @db.VarChar(5)
  privacySettings Json     @default("{}") @map("privacy_settings")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("member_profiles")
}

/// Phiên đăng nhập / quản lý thiết bị.
model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName       String?   @map("device_name") @db.VarChar(150)
  devicePlatform   String?   @map("device_platform") @db.VarChar(20)
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Text
  ipAddress        String?   @map("ip_address")
  lastActiveAt     DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

/// Mã OTP (chỉ lưu hash).
model PhoneOtpCode {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String    @db.VarChar(20)
  codeHash   String    @map("code_hash") @db.Text
  purpose    String    @db.VarChar(20)
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("phone_otp_codes")
}

/// Thiết bị nhận push FCM/APNs.
model PushDevice {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String   @db.VarChar(10)
  token     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, token])
  @@map("push_devices")
}

// ---------------------------------------------------------------------------
// 2.3. NHÓM DÒNG HỌ VÀ GIA PHẢ
// ---------------------------------------------------------------------------

model Lineage {
  id                   String    @id @default(uuid()) @db.Uuid
  name                 String    @db.VarChar(255)
  branchName           String?   @map("branch_name") @db.VarChar(255)
  hometownProvince     String?   @map("hometown_province") @db.VarChar(100)
  hometownCommune      String?   @map("hometown_commune") @db.VarChar(100)
  ancestralHallAddress String?   @map("ancestral_hall_address") @db.Text
  avatarUrl            String?   @map("avatar_url") @db.Text
  emblemUrl            String?   @map("emblem_url") @db.Text
  founderPersonId      String?   @map("founder_person_id") @db.Uuid
  founderPerson        FamilyPerson? @relation("LineageFounder", fields: [founderPersonId], references: [id], onDelete: SetNull)
  visibility           String    @default("invite_only") @db.VarChar(20)
  defaultTreeLayout    String    @default("vertical") @map("default_tree_layout") @db.VarChar(20)
  createdBy            String?   @map("created_by") @db.Uuid
  createdByUser        User?     @relation("LineageCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  /// Trưởng tộc — người sở hữu duy nhất của họ (xem enum LineageRole).
  ownerUserId          String?   @map("owner_user_id") @db.Uuid
  owner                User?     @relation("LineageOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(6)

  memberships      LineageMembership[]
  invites          LineageInvite[]
  persons          FamilyPerson[]
  relationships    FamilyRelationship[]
  changeRequests   GenealogyChangeRequest[]
  permissions      GenealogyPermission[]
  conversations    ChatConversation[]
  posts            Post[]
  events           Event[]
  polls            Poll[]
  auditLogs        AuditLog[]

  @@map("lineages")
}

/// Tư cách thành viên: một tài khoản tham gia nhiều dòng họ (n–n).
model LineageMembership {
  id               String      @id @default(uuid()) @db.Uuid
  lineageId        String      @map("lineage_id") @db.Uuid
  lineage          Lineage     @relation(fields: [lineageId], references: [id], onDelete: Cascade)
  userId           String      @map("user_id") @db.Uuid
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             LineageRole @default(MEMBER)
  status           String      @default("pending") @db.VarChar(20)
  requestedBranch  String?     @map("requested_branch") @db.VarChar(255)
  requestedRelation String?    @map("requested_relation") @db.Text
  reviewedBy       String?     @map("reviewed_by") @db.Uuid
  reviewer         User?       @relation("MembershipReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  joinedAt         DateTime?   @map("joined_at") @db.Timestamptz(6)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([lineageId, userId])
  @@index([lineageId])
  @@index([userId])
  @@map("lineage_memberships")
}

/// Liên kết/mã mời tham gia dòng họ.
model LineageInvite {
  id        String    @id @default(uuid()) @db.Uuid
  lineageId String    @map("lineage_id") @db.Uuid
  lineage   Lineage   @relation(fields: [lineageId], references: [id], onDelete: Cascade)
  code      String    @unique @db.VarChar(64)
  createdBy String?   @map("created_by") @db.Uuid
  creator   User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  maxUses   Int?      @map("max_uses")
  usedCount Int       @default(0) @map("used_count")
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("lineage_invites")
}

/// Hồ sơ người trong gia phả — TÁCH BIỆT users (HNT-T-011, HNT-T-024).
model FamilyPerson {
  id                String             @id @default(uuid()) @db.Uuid
  lineageId         String             @map("lineage_id") @db.Uuid
  lineage           Lineage            @relation(fields: [lineageId], references: [id], onDelete: Restrict)
  fullName          String             @map("full_name") @db.VarChar(150)
  nickname          String?            @db.VarChar(100)
  avatarUrl         String?            @map("avatar_url") @db.Text
  gender            String?            @db.VarChar(20)
  dateOfBirth       DateTime?          @map("date_of_birth") @db.Date
  birthYearOnly     Boolean            @default(false) @map("birth_year_only")
  dateOfDeath       DateTime?          @map("date_of_death") @db.Date
  hometown          String?            @db.VarChar(255)
  currentPlace      String?            @map("current_place") @db.VarChar(255)
  phone             String?            @db.VarChar(20)
  email             String?            @db.VarChar(255)
  occupation        String?            @db.VarChar(255)
  education         String?            @db.VarChar(255)
  bloodType         String?            @map("blood_type") @db.VarChar(5)
  hobbies           String?            @db.Text
  bio               String?            @db.Text
  // MỞ RỘNG so với spec: vị trí phần mộ (yêu cầu từ bản prototype — hồ sơ
  // hiển thị "Phần mộ ở đâu" khi người đã mất). Tên cột snake_case.
  burialPlace       String?            @map("burial_place") @db.VarChar(255)
  generation        Int?
  branch            String?            @db.VarChar(255)
  roleInLineage     String?            @map("role_in_lineage") @db.VarChar(255)
  verificationStatus VerificationStatus @default(DRAFT) @map("verification_status")
  createdBy         String?            @map("created_by") @db.Uuid
  creator           User?              @relation("PersonCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy         String?            @map("updated_by") @db.Uuid
  updater           User?              @relation("PersonUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamptz(6)

  relationshipsAsPerson  FamilyRelationship[] @relation("RelPerson")
  relationshipsAsRelated FamilyRelationship[] @relation("RelRelated")
  accountLink            PersonAccountLink?
  changeRequests         GenealogyChangeRequest[]
  permissions            GenealogyPermission[]
  foundedLineages        Lineage[]            @relation("LineageFounder")

  @@index([lineageId])
  @@index([lineageId, generation])
  // Index FTS/trigram cho tìm kiếm tên (HNT-T-008) — bổ sung trong migration SQL:
  // CREATE INDEX ... ON family_persons USING gin (to_tsvector('simple', full_name));
  // CREATE INDEX ... ON family_persons USING gin (full_name gin_trgm_ops);
  @@map("family_persons")
}

/// Quan hệ gia đình có cấu trúc (lưu hai chiều ở tầng nghiệp vụ).
model FamilyRelationship {
  id               String       @id @default(uuid()) @db.Uuid
  lineageId        String       @map("lineage_id") @db.Uuid
  lineage          Lineage      @relation(fields: [lineageId], references: [id], onDelete: Restrict)
  personId         String       @map("person_id") @db.Uuid
  person           FamilyPerson @relation("RelPerson", fields: [personId], references: [id], onDelete: Cascade)
  relatedPersonId  String       @map("related_person_id") @db.Uuid
  relatedPerson    FamilyPerson @relation("RelRelated", fields: [relatedPersonId], references: [id], onDelete: Cascade)
  relationshipType String       @map("relationship_type") @db.VarChar(30)
  startDate        DateTime?    @map("start_date") @db.Date
  endDate          DateTime?    @map("end_date") @db.Date
  note             String?      @db.Text
  createdBy        String?      @map("created_by") @db.Uuid
  creator          User?        @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  changeRequests GenealogyChangeRequest[]

  // CHECK (person_id <> related_person_id) — bổ sung trong migration SQL.
  @@unique([lineageId, personId, relatedPersonId, relationshipType])
  @@index([personId])
  @@index([relatedPersonId])
  @@map("family_relationships")
}

/// Liên kết duy nhất: tài khoản ↔ hồ sơ gia phả (có xác minh).
model PersonAccountLink {
  id         String    @id @default(uuid()) @db.Uuid
  personId   String    @unique @map("person_id") @db.Uuid
  person     FamilyPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     String    @default("pending") @db.VarChar(20)
  verifiedBy String?   @map("verified_by") @db.Uuid
  verifier   User?     @relation("AccountLinkVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([personId, userId])
  @@map("person_account_links")
}

/// Đề xuất chỉnh sửa/xác minh gia phả (GP-06/GP-07); payload đồng thời là
/// lịch sử chỉnh sửa (GP-09).
model GenealogyChangeRequest {
  id             String             @id @default(uuid()) @db.Uuid
  lineageId      String             @map("lineage_id") @db.Uuid
  lineage        Lineage            @relation(fields: [lineageId], references: [id], onDelete: Cascade)
  personId       String?            @map("person_id") @db.Uuid
  person         FamilyPerson?      @relation(fields: [personId], references: [id], onDelete: SetNull)
  relationshipId String?            @map("relationship_id") @db.Uuid
  relationship   FamilyRelationship? @relation(fields: [relationshipId], references: [id], onDelete: SetNull)
  requestType    String             @map("request_type") @db.VarChar(30)
  payload        Json
  reason         String?            @db.Text
  reviewNote     String?            @map("review_note") @db.Text
  status         String             @default("pending") @db.VarChar(20)
  requestedBy    String             @map("requested_by") @db.Uuid
  requester      User               @relation("ChangeRequester", fields: [requestedBy], references: [id], onDelete: SetNull)
  reviewedBy     String?            @map("reviewed_by") @db.Uuid
  reviewer       User?              @relation("ChangeReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([lineageId, status])
  @@map("genealogy_change_requests")
}

/// Quyền xem/đề xuất/sửa/duyệt gia phả — ĐỘC LẬP với verification_status (HNT-T-024).
/// Partial unique index theo spec — bổ sung trong migration SQL:
///   CREATE UNIQUE INDEX uq_genperm_scope ON genealogy_permissions (lineage_id, user_id) WHERE person_id IS NULL;
///   CREATE UNIQUE INDEX uq_genperm_person ON genealogy_permissions (lineage_id, user_id, person_id) WHERE person_id IS NOT NULL;
model GenealogyPermission {
  id         String       @id @default(uuid()) @db.Uuid
  lineageId  String       @map("lineage_id") @db.Uuid
  lineage    Lineage      @relation(fields: [lineageId], references: [id], onDelete: Cascade)
  userId     String       @map("user_id") @db.Uuid
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  personId   String?      @map("person_id") @db.Uuid
  person     FamilyPerson? @relation(fields: [personId], references: [id], onDelete: Cascade)
  canView    Boolean      @default(false) @map("can_view")
  canPropose Boolean      @default(false) @map("can_propose")
  canEdit    Boolean      @default(false) @map("can_edit")
  canVerify  Boolean      @default(false) @map("can_verify")
  canManage  Boolean      @default(false) @map("can_manage")
  grantedBy  String?      @map("granted_by") @db.Uuid
  granter    User?        @relation("PermissionGranter", fields: [grantedBy], references: [id], onDelete: SetNull)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([lineageId, userId])
  @@map("genealogy_permissions")
}

// ---------------------------------------------------------------------------
// 2.4. NHÓM CHAT VÀ NHẮN TIN
// ---------------------------------------------------------------------------

/// Cuộc trò chuyện. Lưu ý kiến trúc: thành viên nhóm chat không mặc nhiên có
/// quyền sửa gia phả — hai hệ quyền độc lập.
model ChatConversation {
  id          String       @id @default(uuid()) @db.Uuid
  type        ChatRoomType
  lineageId   String?      @map("lineage_id") @db.Uuid
  lineage     Lineage?     @relation(fields: [lineageId], references: [id], onDelete: SetNull)
  title       String?      @db.VarChar(255)
  avatarUrl   String?      @map("avatar_url") @db.Text
  description String?      @db.Text
  createdBy   String?      @map("created_by") @db.Uuid
  creator     User?        @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  settings    Json         @default("{}")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz(6)

  members         ConversationMember[]
  messages        Message[]
  messageRequests MessageRequest[]
  events          Event[]
  polls           Poll[]

  @@map("chat_conversations")
}

model ConversationMember {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String           @map("user_id") @db.Uuid
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String           @default("member") @db.VarChar(20)
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt         DateTime?        @map("left_at") @db.Timestamptz(6)
  mutedUntil     DateTime?        @map("muted_until") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([conversationId, userId])
  @@map("conversation_members")
}

/// Tin nhắn — persist trước khi ack/broadcast (HNT-T-012); idempotency qua
/// (conversation_id, client_message_id) (HNT-T-013).
model Message {
  id                 String            @id @default(uuid()) @db.Uuid
  conversationId     String            @map("conversation_id") @db.Uuid
  conversation       ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId           String?           @map("sender_id") @db.Uuid
  sender             User?             @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderNameSnapshot String?           @map("sender_name_snapshot") @db.VarChar(100)
  clientMessageId    String            @map("client_message_id") @db.VarChar(64)
  type               String            @db.VarChar(20)
  content            String?           @db.Text
  replyToId          String?           @map("reply_to_id") @db.Uuid
  replyTo            Message?          @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies            Message[]         @relation("MessageReply")
  forwardedFromId    String?           @map("forwarded_from_id") @db.Uuid
  forwardedFrom      Message?          @relation("MessageForward", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  forwards           Message[]         @relation("MessageForward")
  status             String            @default("sent") @db.VarChar(20)
  editedAt           DateTime?         @map("edited_at") @db.Timestamptz(6)
  recalledAt         DateTime?         @map("recalled_at") @db.Timestamptz(6)
  deletedForAllAt    DateTime?         @map("deleted_for_all_at") @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  attachments MessageAttachment[]
  reactions   MessageReaction[]
  reads       MessageRead[]

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt(sort: Desc)])
  // Index FTS cho tìm kiếm tin nhắn (CHAT-14) — bổ sung trong migration SQL:
  // CREATE INDEX ... ON messages USING gin (to_tsvector('simple', content));
  @@map("messages")
}

model MessageAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  messageId    String   @map("message_id") @db.Uuid
  message      Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  storageKey   String   @map("storage_key") @db.Text
  fileName     String   @map("file_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  sizeBytes    BigInt   @map("size_bytes")
  width        Int?
  height       Int?
  durationSec  Int?     @map("duration_sec")
  thumbnailKey String?  @map("thumbnail_key") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("message_attachments")
}

model MessageReaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String   @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([messageId, userId, emoji])
  @@map("message_reactions")
}

model MessageRead {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now()) @map("read_at") @db.Timestamptz(6)

  @@unique([messageId, userId])
  @@map("message_reads")
}

/// Yêu cầu nhắn tin từ người lạ (chống spam, không lộ trạng thái online).
model MessageRequest {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @unique @map("conversation_id") @db.Uuid
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requesterId    String           @map("requester_id") @db.Uuid
  requester      User             @relation("MessageRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  targetId       String           @map("target_id") @db.Uuid
  target         User             @relation("MessageTarget", fields: [targetId], references: [id], onDelete: Cascade)
  status         String           @default("pending") @db.VarChar(20)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedAt      DateTime?        @map("decided_at") @db.Timestamptz(6)

  // CHECK (requester_id <> target_id) — bổ sung trong migration SQL.
  @@map("message_requests")
}

// ---------------------------------------------------------------------------
// 2.5. NHÓM KẾT BẠN, CHẶN, BÁO CÁO
// ---------------------------------------------------------------------------

model Friendship {
  id          String   @id @default(uuid()) @db.Uuid
  requesterId String   @map("requester_id") @db.Uuid
  requester   User     @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String   @map("addressee_id") @db.Uuid
  addressee   User     @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      String   @default("pending") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // CHECK (requester_id <> addressee_id) — bổ sung trong migration SQL.
  @@unique([requesterId, addresseeId])
  @@map("friendships")
}

model BlockedUser {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String   @map("blocked_id") @db.Uuid
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  reason    String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // CHECK (blocker_id <> blocked_id) — bổ sung trong migration SQL.
  @@unique([blockerId, blockedId])
  @@map("blocked_users")
}

model Report {
  id         String    @id @default(uuid()) @db.Uuid
  reporterId String?   @map("reporter_id") @db.Uuid
  reporter   User?     @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  targetType String    @map("target_type") @db.VarChar(20)
  targetId   String    @map("target_id") @db.Uuid
  reason     String    @db.VarChar(100)
  details    String?   @db.Text
  status     String    @default("pending") @db.VarChar(20)
  handledBy  String?   @map("handled_by") @db.Uuid
  handler    User?     @relation("ReportHandler", fields: [handledBy], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("reports")
}

// ---------------------------------------------------------------------------
// 2.6. NHÓM CỘNG ĐỒNG: BẢNG TIN, SỰ KIỆN, BÌNH CHỌN
// ---------------------------------------------------------------------------

model Post {
  id                 String    @id @default(uuid()) @db.Uuid
  lineageId          String    @map("lineage_id") @db.Uuid
  lineage            Lineage   @relation(fields: [lineageId], references: [id], onDelete: Cascade)
  authorId           String?   @map("author_id") @db.Uuid
  author             User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorNameSnapshot String?   @map("author_name_snapshot") @db.VarChar(100)
  title              String?   @db.VarChar(255)
  content            String    @db.Text
  category           String?   @db.VarChar(30)
  visibility         String    @default("lineage") @db.VarChar(20)
  branch             String?   @db.VarChar(255)
  isPinned           Boolean   @default(false) @map("is_pinned")
  status             String    @default("published") @db.VarChar(20)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  comments    Comment[]
  attachments PostAttachment[]
  reactions   PostReaction[]

  @@index([lineageId, createdAt(sort: Desc)])
  @@index([lineageId, isPinned])
  @@map("posts")
}

model Comment {
  id              String    @id @default(uuid()) @db.Uuid
  postId          String    @map("post_id") @db.Uuid
  post            Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId        String?   @map("author_id") @db.Uuid
  author          User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parentCommentId String?   @map("parent_comment_id") @db.Uuid
  parentComment   Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[] @relation("CommentReplies")
  content         String    @db.Text
  status          String    @default("published") @db.VarChar(20)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("comments")
}

model PostAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  postId       String   @map("post_id") @db.Uuid
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  storageKey   String   @map("storage_key") @db.Text
  thumbnailKey String?  @map("thumbnail_key") @db.Text
  mimeType     String   @map("mime_type") @db.VarChar(100)
  sizeBytes    BigInt   @map("size_bytes")
  position     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("post_attachments")
}

model PostReaction {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String   @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([postId, userId, emoji])
  @@map("post_reactions")
}

model Event {
  id             String            @id @default(uuid()) @db.Uuid
  lineageId      String            @map("lineage_id") @db.Uuid
  lineage        Lineage           @relation(fields: [lineageId], references: [id], onDelete: Cascade)
  conversationId String?           @map("conversation_id") @db.Uuid
  conversation   ChatConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  title          String            @db.VarChar(255)
  description    String?           @db.Text
  eventType      EventType         @map("event_type")
  startAt        DateTime          @map("start_at") @db.Timestamptz(6)
  endAt          DateTime?         @map("end_at") @db.Timestamptz(6)
  lunarDate      String?           @map("lunar_date") @db.VarChar(20)
  location       String?           @db.VarChar(255)
  organizerId    String?           @map("organizer_id") @db.Uuid
  organizer      User?             @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: SetNull)
  coverUrl       String?           @map("cover_url") @db.Text
  status         String            @default("upcoming") @db.VarChar(20)
  createdBy      String?           @map("created_by") @db.Uuid
  creator        User?             @relation("EventCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  participants EventParticipant[]

  @@map("events")
}

model EventParticipant {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rsvpStatus String   @default("invited") @map("rsvp_status") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([eventId, userId])
  @@map("event_participants")
}

model Poll {
  id             String            @id @default(uuid()) @db.Uuid
  lineageId      String?           @map("lineage_id") @db.Uuid
  lineage        Lineage?          @relation(fields: [lineageId], references: [id], onDelete: SetNull)
  conversationId String?           @map("conversation_id") @db.Uuid
  conversation   ChatConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  question       String            @db.Text
  createdBy      String?           @map("created_by") @db.Uuid
  creator        User?             @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  closesAt       DateTime?         @map("closes_at") @db.Timestamptz(6)
  status         String            @default("open") @db.VarChar(20)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  options PollOption[]
  votes   PollVote[]

  @@map("polls")
}

model PollOption {
  id         String   @id @default(uuid()) @db.Uuid
  pollId     String   @map("poll_id") @db.Uuid
  poll       Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionText String   @map("option_text") @db.Text
  position   Int

  votes PollVote[]

  @@map("poll_options")
}

model PollVote {
  id       String     @id @default(uuid()) @db.Uuid
  pollId   String     @map("poll_id") @db.Uuid
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId String     @map("option_id") @db.Uuid
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId   String     @map("user_id") @db.Uuid
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([pollId, userId])
  @@map("poll_votes")
}

// ---------------------------------------------------------------------------
// 2.7. NHÓM THÔNG BÁO VÀ VẬN HÀNH
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    @db.VarChar(40)
  title     String    @db.VarChar(255)
  body      String?   @db.Text
  data      Json?
  dedupKey  String?   @unique @map("dedup_key") @db.VarChar(128)
  isRead    Boolean   @default(false) @map("is_read")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model NotificationSetting {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quietHoursStart DateTime? @map("quiet_hours_start") @db.Time
  quietHoursEnd   DateTime? @map("quiet_hours_end") @db.Time
  perConversation Json      @default("{}") @map("per_conversation")
  soundEnabled    Boolean   @default(true) @map("sound_enabled")
  emailEnabled    Boolean   @default(false) @map("email_enabled")
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("notification_settings")
}

/// Nhật ký kiểm toán — chỉ append. Thu hồi UPDATE/DELETE trên bảng này đối
/// với role ứng dụng ở tầng database (HNT-T-020) — bổ sung trong migration SQL:
///   REVOKE UPDATE, DELETE ON audit_logs FROM honhatoi_app;
model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  actorId    String?   @map("actor_id") @db.Uuid
  actor      User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String    @db.VarChar(100)
  targetType String?   @map("target_type") @db.VarChar(50)
  targetId   String?   @map("target_id") @db.Uuid
  lineageId  String?   @map("lineage_id") @db.Uuid
  lineage    Lineage?  @relation(fields: [lineageId], references: [id], onDelete: SetNull)
  metadata   Json?
  ipAddress  String?   @map("ip_address")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([targetType, targetId])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([lineageId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// Yêu cầu xuất/sửa/xóa dữ liệu cá nhân.
model DataDeletionRequest {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: SetNull)
  requestType String    @map("request_type") @db.VarChar(20)
  status      String    @default("pending") @db.VarChar(20)
  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  @@map("data_deletion_requests")
}
