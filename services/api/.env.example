# Copy sang .env khi chạy local. KHÔNG commit file .env thật.
DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=your-strong-secret-here-min-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
PORT=3001
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"

# Lưu ảnh (chat). Chọn một: Vercel Blob (kho PRIVATE) hoặc thư mục trên máy chủ.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...   # Vercel tự thêm khi gắn kho Blob
# STORAGE_DIR=./uploads                      # VPS / chạy local
# STORAGE_DRIVER=blob|disk                   # tùy chọn, ép driver

# Thông báo đẩy Web Push (nhắc giỗ). Tạo khóa: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Khóa cho cron nhắc giỗ (Vercel Cron tự gửi Authorization: Bearer <CRON_SECRET>)
# CRON_SECRET=
